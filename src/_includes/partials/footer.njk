<footer class="paticka">
  <div class="wrap">
    <div class="rule paticka__sloupce">
      <div>
        <img class="paticka__logo" src="{{ '/assets/img/logo/logo-haltuf-cerne-v2.svg' | url }}" alt="Haltuf – Želvy ČR" width="132" height="149" loading="lazy">
        <p>
          <a class="js-tel-paticka" href="tel:{{ site.telefon | telHref }}">+420 {{ site.telefon }}</a><br>
          Odběr: {{ site.kontakt.odberneMisto }}<br>
          Chov: {{ site.kontakt.chov }}
        </p>
      </div>
      <div>
        <h2 class="paticka__nadpis">Nabídka</h2>
        <ul>
          {% for p in paticka.nabidka %}<li><a href="{{ p.url | url }}">{{ p.nazev }}</a></li>{% endfor %}
        </ul>
      </div>
      <div>
        <h2 class="paticka__nadpis">Průvodce chovem</h2>
        <ul>
          {% for p in paticka.pruvodce %}<li><a href="{{ p.url | url }}">{{ p.nazev }}</a></li>{% endfor %}
        </ul>
      </div>
      <div>
        <h2 class="paticka__nadpis">Informace</h2>
        <ul>
          {% for p in paticka.informace %}<li><a href="{{ p.url | url }}">{{ p.nazev }}</a></li>{% endfor %}
        </ul>
      </div>
    </div>
    <p class="paticka__legal">
      {{ site.firma.jmeno }}, {{ site.firma.adresa }} · IČO {{ site.firma.ico }} · zapsán v živnostenském rejstříku, {{ site.firma.zivnostenskyUrad }}
    </p>
  </div>
</footer>
