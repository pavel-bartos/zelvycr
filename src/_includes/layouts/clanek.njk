---
layout: layouts/base.njk
---
{% set _nav = page.fileSlug | prevNextClanek(pruvodcePoradi) %}
<article class="clanek">

  {# 1 — Hlavička #}
  <header class="wrap clanek-hlavicka">
    <nav class="drobky" aria-label="Drobečková navigace">
      <a href="{{ '/' | url }}">Úvod</a> <span aria-hidden="true">›</span>
      <a href="{{ '/pruvodce-chovem/' | url }}">Průvodce chovem</a> <span aria-hidden="true">›</span>
      <span aria-current="page">{{ title }}</span>
    </nav>

    {# Jemná prev/next navigace — viditelná jen v průvodci #}
    {% if _nav.prev or _nav.next %}
    <nav class="clanek-tutorial-nav" aria-label="Listování průvodcem">
      {% if _nav.prev %}
        <a class="clanek-tutorial-nav__prev" href="{{ ('/pruvodce-chovem/' + _nav.prev.slug + '/') | url }}">← {{ _nav.prev.title }}</a>
      {% endif %}
      {% if _nav.next %}
        <a class="clanek-tutorial-nav__next" href="{{ ('/pruvodce-chovem/' + _nav.next.slug + '/') | url }}">{{ _nav.next.title }} →</a>
      {% endif %}
    </nav>
    {% endif %}

    <div class="rule clanek-hlavicka__obsah">
      {% if skupinaKicker %}
        <div class="kick">{{ skupinaKicker }}</div>
      {% endif %}
      <h1 class="disp">{{ title }}</h1>
      {% if perex %}
        <p class="clanek-perex">{{ perex }}</p>
      {% endif %}
      {% if casCteni %}
        <p class="clanek-meta">Čas čtení: {{ casCteni }}</p>
      {% endif %}
    </div>
  </header>

  {# 2 — Úvodní fotka (zobrazí se jen když článek foto definuje) #}
  {% if foto %}
  <div class="wrap">
    <figure class="clanek-foto"{% if fotoPozice %} style="--foto-pozice: {{ fotoPozice }}"{% endif %}>
      <img src="{{ foto }}" alt="{{ fotoAlt }}" width="800" height="533" fetchpriority="high">
      {% if fotoPopisek %}<figcaption>{{ fotoPopisek }}</figcaption>{% endif %}
    </figure>
  </div>
  {% endif %}

  {# 3 — V kostce (zobrazí se jen když článek vKostce definuje) #}
  {% if vKostce %}
  <section class="wrap sekce">
    <aside class="box-v-kostce">
      <div class="kick">V kostce</div>
      {{ vKostce | safe }}
    </aside>
  </section>
  {% endif %}

  {# 4 — Tělo článku #}
  <section class="wrap clanek-telo">
    {{ content | safe }}
  </section>

  {# 5 — Rozcestník prev/next (dole pod článkem) #}
  {% if _nav.prev or _nav.next %}
  <nav class="wrap clanek-tutorial-rozcestnik" aria-label="Další a předchozí článek průvodce">
    <div class="clanek-tutorial-rozcestnik__karty">
      {% if _nav.prev %}
      <div class="clanek-tutorial-rozcestnik__polozka">
        <span class="clanek-tutorial-rozcestnik__label">Předchozí článek</span>
        <a class="row row--clanek" href="{{ ('/pruvodce-chovem/' + _nav.prev.slug + '/') | url }}">
          <img src="{{ _nav.prev.foto }}" alt="" width="240" height="135" loading="lazy">
          <div class="row__text">
            <strong class="row__nazev">{{ _nav.prev.title }}</strong>
            <span class="row__perex">{{ _nav.prev.popisek }}</span>
          </div>
        </a>
      </div>
      {% endif %}
      {% if _nav.next %}
      <div class="clanek-tutorial-rozcestnik__polozka">
        <span class="clanek-tutorial-rozcestnik__label">Další článek</span>
        <a class="row row--clanek" href="{{ ('/pruvodce-chovem/' + _nav.next.slug + '/') | url }}">
          <img src="{{ _nav.next.foto }}" alt="" width="240" height="135" loading="lazy">
          <div class="row__text">
            <strong class="row__nazev">{{ _nav.next.title }}</strong>
            <span class="row__perex">{{ _nav.next.popisek }}</span>
          </div>
        </a>
      </div>
      {% endif %}
    </div>
  </nav>
  {% endif %}

</article>
