---
layout: layouts/base.njk
---
<article class="clanek">

  {# 1 — Hlavička #}
  <header class="wrap clanek-hlavicka">
    <nav class="drobky" aria-label="Drobečková navigace">
      <a href="{{ '/' | url }}">Úvod</a> <span aria-hidden="true">›</span>
      <a href="{{ '/pruvodce-chovem/' | url }}">Průvodce chovem</a> <span aria-hidden="true">›</span>
      <span aria-current="page">{{ title }}</span>
    </nav>
    <div class="rule clanek-hlavicka__obsah">
      {% if skupinaKicker %}
        <div class="kick">{{ skupinaKicker }}</div>
      {% endif %}
      <h1 class="disp">{{ title }}</h1>
      {% if perex %}
        <p class="clanek-perex">{{ perex }}</p>
      {% endif %}
      {% if casCteni %}
        <p class="clanek-meta">Čas čtení: {{ casCteni }}</p>
      {% endif %}
    </div>
  </header>

  {# 2 — Úvodní fotka (zobrazí se jen když článek foto definuje) #}
  {% if foto %}
  <div class="wrap">
    <figure class="clanek-foto"{% if fotoPozice %} style="--foto-pozice: {{ fotoPozice }}"{% endif %}>
      <img src="{{ foto }}" alt="{{ fotoAlt }}" width="800" height="533" fetchpriority="high">
      {% if fotoPopisek %}<figcaption>{{ fotoPopisek }}</figcaption>{% endif %}
    </figure>
  </div>
  {% endif %}

  {# 3 — V kostce (zobrazí se jen když článek vKostce definuje) #}
  {% if vKostce %}
  <section class="wrap sekce">
    <aside class="box-v-kostce">
      <div class="kick">V kostce</div>
      {{ vKostce | safe }}
    </aside>
  </section>
  {% endif %}

  {# 4 — Tělo článku #}
  <section class="wrap clanek-telo">
    {{ content | safe }}
  </section>

</article>
