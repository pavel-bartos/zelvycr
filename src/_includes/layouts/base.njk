<!doctype html>
<html lang="{{ site.jazyk }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title }}{% if title %} | {% endif %}{{ site.nazev }}</title>
    <meta name="description" content="{{ description or site.popis }}" />
    {% if site.prototyp %}
    <meta name="robots" content="noindex, nofollow" />
    {% endif %}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&amp;family=Public+Sans:wght@400;600;700&amp;display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}" />
  </head>
  <body>
    {% if site.prototyp %}
    <p class="prototyp-pruh" role="status">
      Pracovní prototyp — obsah i ceny nejsou finální.
    </p>
    {% endif %} {% include "partials/akce-pruh.njk" %} {% include "partials/header.njk" %}

    <main id="obsah">{{ content | safe }}</main>

    {% include "partials/cta.njk" %} {% include "partials/footer.njk" %} {% include
    "partials/sticky-call.njk" %}
  </body>
</html>
